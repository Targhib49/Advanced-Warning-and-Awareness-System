# Arguments for the AWAS boot service (installed as /etc/default/awas).
# Edit, then: sudo systemctl restart awas
#
#   --headless         no debug window; the dashboard is the screen
#   --dashboard 8095   centre-screen app at http://awas.local:8095
#   --setup            start on "Who's driving?": register, consent, guided
#                      calibration (camera shown only then), then drive.
#                      Add --driver <id> to skip straight to a calibrated driver;
#                      without --setup, --driver <name> is the old fixed-driver mode
#   --sim              speed, steering and lane from the ETS2 bridge (UDP 8097)
#   --mute             decide and log, but stay silent
#   --condition A-D    experimental condition (see --conditions)
#   --eye-signal ear   EAR only, the control condition (default: the T1 CNN,
#                      falling back to EAR on frames it cannot crop)
#   --fusion asymmetric  keep early warnings either channel raises (default:
#                      weighted, which suppresses facial false alarms the
#                      lane contradicts — results §D-3)
#   --camera-view      debug view with the camera at /camera — demos only,
#                      images of the driver leave the device
#
# While no simulator is connected the speed is the manual demo speed, changed
# with [ and ] on the dashboard page; a connected ETS2 bridge takes over.
AWAS_ARGS="--setup --condition C --headless --dashboard 8095 --sim"
